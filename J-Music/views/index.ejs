<%- include('header') %>

<main class="container">
    <section class="bienvenida">
        <h1><%= t.bienvenida_titulo %></h1>
        <p><%= t.bienvenida_sub %></p>
        
        <div class="caja-imagenes">
            <!-- Imagen Izquierda -->
            <img src="/img/Malice Mizer.jpg" alt="Concierto Malice Mizer">
            
            <!-- Imagen Derecha -->
            <img src="/img/kuroyuri.jpg" alt="Otra banda en vivo">
        </div>
    </section>

    <!-- ================================================= -->
    <!-- NUEVA SECCIÓN: ÚLTIMOS 5 AGREGADOS DE SUPABASE -->
    <!-- ================================================= -->
    <section class="ultimos-agregados" style="margin: 40px 0; padding: 0 20px;">
        <h2 style="color: #fff; text-align: center; margin-bottom: 25px;"><%= t.ultimos_agregados %></h2>
        
        <% if (typeof ultimosAgregados !== 'undefined' && ultimosAgregados.length > 0) { %>
            <div class="lista-artistas" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;">
                <% ultimosAgregados.forEach(video => { %>
                    <div class="artista-card" style="background: #111; padding: 15px; border-radius: 6px; position: relative;">
                        
                        <% if (video.portada_url) { %>
                            <img src="<%= video.portada_url %>" alt="<%= video.titulo %>" referrerpolicy="no-referrer" style="width: 100%; height: 160px; object-fit: cover; border-radius: 4px;">
                        <% } %>
                        
                        <h3 style="font-size: 1rem; color: #fff; margin: 10px 0;"><%= video.titulo || 'Sin título' %></h3>
                        <p style="font-size: 0.85rem; color: #aaa; margin-bottom: 10px;"><%= t.lanzamiento %>: <%= video.fecha_lanzamiento || 'N/A' %></p>
                        
                        <% if (video.artista_id) { %>
                            <a href="/detalle/<%= video.artista_id %>" class="btn-descarga" style="display: inline-block; padding: 6px 12px; background: #8b0000; color: #fff; text-decoration: none; border-radius: 4px; font-size: 0.85rem;"><%= t.ver_detalle %></a>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <p style="text-align: center; color: #888;"><%= t.no_registros %></p>
        <% } %>
    </section>
    <!-- ================================================= -->

    <section class="descripcion">
        <h2><%= t.seccion_decadas %></h2>
        <p><%= t.desc_decadas %></p>
        
        <div class="cronologia" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin: 30px 0;">
            <div class="epoca">
                <h3>80s & 90s</h3>
                <div class="galeria-4">
                    <!-- Banda 1 -->
                    <div class="epoca-img-container">
                        <img src="/img/X.jpg" alt="X Japan">
                        <div class="overlay">X Japan</div>
                    </div>
                    <!-- Banda 2 -->
                    <div class="epoca-img-container">
                        <img src="/img/LUNASEA.jpg" alt="LUNA SEA">
                        <div class="overlay">LUNA SEA</div>
                    </div>
                    <!-- Banda 3 -->
                    <div class="epoca-img-container">
                        <img src="/img/buck-tick.jpg" alt="BUCK-TICK">
                        <div class="overlay">BUCK-TICK</div>
                    </div>
                    <!-- Banda 4 -->
                    <div class="epoca-img-container">
                        <img src="/img/Dir En Grey.jpg" alt="DIR EN GREY">
                        <div class="overlay">DIR EN GREY</div>
                    </div>
                </div>
                <p><%= t.decada_80_90_desc %></p>
            </div>

            <div class="epoca">
                <h3>2000s - ACTUALIDAD</h3>
                <div class="galeria-4">
                    <!-- Banda 1 -->
                    <div class="epoca-img-container">
                        <img src="/img/Nightmare.jpg" alt="NIGHTMARE">
                        <div class="overlay">NIGHTMARE</div>
                    </div>
                    <!-- Banda 2 -->
                    <div class="epoca-img-container">
                        <img src="/img/Alice Nine_.jpg" alt="ALICE NINE">
                        <div class="overlay">ALICE NINE</div>
                    </div>
                    <!-- Banda 3 -->
                    <div class="epoca-img-container">
                        <img src="/img/VERSAILLES.jpg" alt="VERSAILLES">
                        <div class="overlay">VERSAILLES</div>
                    </div>
                    <!-- Banda 4 -->
                    <div class="epoca-img-container">
                        <img src="/img/Moi dix Mois.jpg" alt="Moi dix Mois">
                        <div class="overlay">Moi dix Mois</div>
                    </div>
                </div>
                <p><%= t.decada_2000_desc %></p>
            </div>
        </div>
    </section>

    <section class="filosofia">
        <h2><%= t.compromiso_titulo %></h2>
        <p><%= t.compromiso_p1 %></p>

        <p><strong><%= t.compromiso_rescate_t %>:</strong></p>
        <p><%= t.compromiso_rescate_d %></p>

        <p><strong><%= t.compromiso_distribucion_t %>:</strong></p>
        <p><%= t.compromiso_distribucion_d %></p>

        <p><strong><%= t.compromiso_esfuerzo_t %>:</strong></p>
        <p><%= t.compromiso_esfuerzo_d %></p>
    </section>
</main>

<%- include('footer') %>
