<%- include('header') %>

<main class="container">
    <article class="sobre-nosotros-contenido" style="line-height: 1.6; color: #ccc; max-width: 900px; margin: 0 auto; padding: 20px;">
        
        <h3 style="color: #fff; font-size: 1.4rem; margin-bottom: 20px;"><%= t.nosotros_como_funciona_t %></h3>
        <p><%= t.nosotros_como_funciona_p1 %></p>
        
        <p><%= t.nosotros_proceso_intro %></p>
        <ul style="padding-left: 20px; margin-bottom: 30px;">
            <li style="margin-bottom: 12px;"><strong><%= t.nosotros_fase1_t %>:</strong> <%= t.nosotros_fase1_d %></li>
            <li style="margin-bottom: 12px;"><strong><%= t.nosotros_fase2_t %>:</strong> <%= t.nosotros_fase2_d %></li>
            <li style="margin-bottom: 12px;"><strong><%= t.nosotros_fase3_t %>:</strong> <%= t.nosotros_fase3_d %></li>
            <li style="margin-bottom: 12px;"><strong><%= t.nosotros_fase4_t %>:</strong> <%= t.nosotros_fase4_d %></li>
        </ul>

        <h3 style="color: #fff; font-size: 1.4rem; margin-bottom: 20px;"><%= t.nosotros_urgencia_t %></h3>
        <p><%= t.nosotros_urgencia_p1 %></p>

        <p><%= t.nosotros_mision_intro %></p>
        <ul style="padding-left: 20px; margin-bottom: 30px;">
            <li style="margin-bottom: 12px;"><strong><%= t.nosotros_mision1_t %>:</strong> <%= t.nosotros_mision1_d %></li>
            <li style="margin-bottom: 12px;"><strong><%= t.nosotros_mision2_t %>:</strong> <%= t.nosotros_mision2_d %></li>
            <li style="margin-bottom: 12px;"><strong><%= t.nosotros_mision3_t %>:</strong> <%= t.nosotros_mision3_d %></li>
            <li style="margin-bottom: 12px;"><strong><%= t.nosotros_mision4_t %>:</strong> <%= t.nosotros_mision4_d %></li>
        </ul>
        
        <p style="margin-bottom: 15px;"><%= t.nosotros_final_p1 %></p>
        <p><%= t.nosotros_final_p2 %></p>
    </article>
</main>

<%- include('footer') %>
